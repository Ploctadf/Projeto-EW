# Required secrets for local development
JWT_SECRET=change-me-local-dev
JWT_REFRESH_SECRET=change-me-refresh-secret
SESSION_SECRET=change-me-interface-session
SESSION_TTL_SECONDS=86400
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# Optional override for the interface session store.
# If omitted, the interface uses MONGO_URL when available, otherwise mongodb://127.0.0.1:27017/ew2026
SESSION_STORE_MONGO_URL=
SESSION_STORE_COLLECTION=interface_sessions

# Public origin allowed by the gateway/API in local development
CORS_ORIGIN=http://localhost:16020
API_CORS_ORIGINS=http://localhost:16020
PUBLIC_BASE_URL=http://localhost:16020

# API rate limit defaults
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=300

# Optional OAuth providers. Leave empty to disable the buttons/routes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

extends ../layout

block content
	- const currentAdmin = 'users'
	section.admin-page
		header.admin-page-header
			div
				p.admin-eyebrow Administração
				h1 Utilizadores
				p Gere perfis e remove contas quando for necessário.
			include _nav.pug

		section.w3-white.secao-card
			if !users.length
				.empty-state
					p Sem utilizadores para mostrar.
			else
				- const perfis = { consumidor: 'Consumidor', produtor: 'Produtor', admin: 'Administrador' }
				table.w3-table-all.w3-hoverable.w3-striped.admin-table
					thead
						tr.w3-teal
							th Nome
							th Email
							th Perfil
							th Ações
					tbody
						each u in users
							tr
								td(data-label='Nome')= u.nome
								td(data-label='Email')= u.email
								td(data-label='Perfil')= perfis[u.role] || u.role
								td.actions
									form(action=`/admin/users/${u._id}/role` method='post')
										select.w3-select(name='role')
											each n in ['consumidor', 'produtor', 'admin']
												option(value=n selected=u.role === n)= perfis[n] || n
										button.w3-button.w3-small.w3-border(type='submit') Atualizar
									form(action=`/admin/users/${u._id}/delete` method='post')
										button.w3-button.w3-small.w3-border(type='submit' onclick="return confirm('Remover este utilizador?');") Remover

doctype html
html(lang='pt')
	head
		meta(charset='utf-8')
		meta(name='viewport' content='width=device-width, initial-scale=1')
		title #{title || 'Plataforma de Recursos'}
		link(rel='stylesheet' href='/stylesheets/style.css')
	body
		header.w3-bar.w3-teal
			a.w3-bar-item.w3-button.w3-xlarge(href='/') EW2026
			a.w3-bar-item.w3-button(href='/resources') Recursos
			a.w3-bar-item.w3-button(href='/posts') Posts
			if user && user.nivel === 'admin'
				a.w3-bar-item.w3-button(href='/admin/users') Admin
			if user
				form.w3-bar-item.w3-right(action='/auth/logout' method='post')
					button.w3-button.w3-white.w3-border(type='submit') Logout
				span.w3-bar-item.w3-right Olá, #{user.nome}
			else
				a.w3-bar-item.w3-button.w3-right(href='/auth/register') Registar
				a.w3-bar-item.w3-button.w3-right(href='/auth/login') Entrar

		main.w3-container.w3-padding
			if success
				div.w3-panel.w3-pale-green.w3-leftbar.w3-border-green
					p= success
			if error
				div.w3-panel.w3-pale-red.w3-leftbar.w3-border-red
					p= error

			block content

		footer.w3-container.w3-padding.w3-small.w3-text-grey
			p Plataforma EW2026 · Interface Web


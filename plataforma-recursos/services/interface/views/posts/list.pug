extends ../layout

block content
	section.w3-card.w3-white.w3-padding.w3-margin-top
		h1 Posts

		if user && (user.nivel === 'produtor' || user.nivel === 'admin')
			p
				a.w3-button.w3-border(href='/posts/new') Criar novo post

		if !items.length
			p Ainda não existem posts.
		else
			ul.w3-ul.w3-hoverable
				each post in items
					li
						a(href=`/posts/${post._id}`)= post.titulo
						span.w3-text-grey.w3-small  · por #{post.autorNome || 'autor desconhecido'}


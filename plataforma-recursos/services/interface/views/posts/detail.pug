extends ../layout

block content
	- const uid = user && (user._id || user.id || user.sub) ? String(user._id || user.id || user.sub) : null
	- const canManagePost = !!(user && (user.role === 'admin' || (uid && String(post.autorId) === uid)))
	section.w3-card.w3-white.w3-padding.w3-margin-top
		h1= post.titulo
		p.w3-text-grey.w3-small Autor: #{post.autorNome || 'desconhecido'}
		p= post.conteudo

		if canManagePost
			div.w3-margin-top
				a.w3-button.w3-border(href=`/posts/${post._id}/edit`) Editar post
				form(action=`/posts/${post._id}/delete` method='post')
					button.w3-button.w3-border(type='submit') Remover post

	section.w3-card.w3-white.w3-padding.w3-margin-top
		h2 Comentários
		if !comments.length
			p Sem comentários.
		else
			ul.w3-ul.w3-hoverable
				each c in comments
					li
						strong= c.autorNome || 'utilizador'
						| : #{c.texto}
						- const canDeleteComment = !!(user && (user.role === 'admin' || (uid && String(c.autorId) === uid)))
						if canDeleteComment
							form(action=`/posts/${post._id}/comments/${c._id}/delete` method='post')
								button.w3-button.w3-small.w3-border(type='submit') Remover comentário

		if user
			form(action=`/posts/${post._id}/comments` method='post')
				label(for='texto') Novo comentário
				textarea#texto.w3-input(name='texto' rows='4' required)
				button.w3-button.w3-teal(type='submit') Comentar
		else
			p.w3-text-grey Inicie sessão para comentar.


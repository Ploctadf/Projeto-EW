extends ../layout

block content
	- const uid = user && (user._id || user.id || user.sub) ? String(user._id || user.id || user.sub) : null
	- const canManagePost = !!(user && (user.role === 'admin' || (uid && String(post.autorId) === uid)))
	- const commentsCountLabel = comments.length === 1 ? '1 comentário' : `${comments.length} comentários`
	section.pagina-detalhe
		section.detalhe-topo
			.etiquetas
				span.etiqueta Publicação
				span.etiqueta.etiqueta--vermelha por #{post.autorNome || 'desconhecido'}
			h1= post.titulo
			if post.resource
				div.post-resource-highlight
					span.post-resource-highlight__label Recurso associado
					strong.post-resource-highlight__title= post.resource.titulo
					if post.resource.tipo
						span.post-resource-highlight__meta= post.resource.tipo
					a.w3-button.botao-claro(href=`/resources/${post.resource._id}`) Abrir recurso
			.conteudo-acoes
				a.w3-button.botao-claro(href='/posts') Voltar às publicações
				if canManagePost
					a.w3-button.botao-principal(href=`/posts/${post._id}/edit`) Editar publicação

		article.section-card.post-detail-card
			.post-detail-card__header
				.post-card__avatar= (post.autorNome || 'autor').trim().charAt(0).toUpperCase() || 'A'
				div
					.post-detail-card__meta
						span Publicação
						span por #{post.autorNome || 'desconhecido'}
						if post.createdAt
							time(datetime=post.createdAt)= new Date(post.createdAt).toLocaleString('pt-PT')
						if post.resourceId
							span Recurso associado
					p.post-detail-card__content= post.conteudo
			if canManagePost
				.conteudo-acoes
					form(action=`/posts/${post._id}/delete` method='post')
						button.w3-button.w3-red(type='submit' onclick="return confirm('Tem a certeza que pretende remover esta publicação?');") Remover publicação

		section.section-card.comments-section
			.cabecalho-secao
				div
					h2 Comentários
					p.w3-text-grey #{commentsCountLabel} nesta publicação.
				if user
					span.feed-count Participar
			if user
				form.formulario-compacto.comment-form(action=`/posts/${post._id}/comments` method='post')
					label(for='texto') Novo comentário
					textarea#texto.w3-input(name='texto' rows='4' required placeholder='Escreve uma resposta clara e útil...')
					button.w3-button.botao-principal(type='submit') Comentar
			else
				.empty-state
					p Inicia sessão para comentar.

			if !comments.length
				.empty-state
					p Sem comentários.
			else
				ul.comment-list
					each c in comments
						- const commentAuthor = c.autorNome || 'utilizador'
						- const commentInitial = commentAuthor.trim().charAt(0).toUpperCase() || 'U'
						li.comment-item
							.comment-item__avatar= commentInitial
							.comment-item__body
								.comment-item__top
									strong= commentAuthor
									if c.createdAt
										time(datetime=c.createdAt)= new Date(c.createdAt).toLocaleString('pt-PT')
								p= c.texto
							- const canDeleteComment = !!(user && (user.role === 'admin' || (uid && String(c.autorId) === uid)))
							if canDeleteComment
								form.comment-item__action(action=`/posts/${post._id}/comments/${c._id}/delete` method='post')
									button.w3-button.w3-small.w3-border(type='submit' onclick="return confirm('Remover este comentário?');") Remover comentário

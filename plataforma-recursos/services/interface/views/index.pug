extends layout

block content
	section.w3-card.w3-white.w3-padding.w3-margin-top
		h1 Plataforma de Gestão e Disponibilização de Recursos Educativos
		p Aceda rapidamente às principais áreas da plataforma.

		ul.w3-ul
			li
				a(href='/resources') Ver recursos educativos
			li
				a(href='/posts') Ver posts e comentários
			if user && user.nivel === 'admin'
				li
					a(href='/admin/users') Gestão de utilizadores
				li
					a(href='/admin/news') Gestão de notícias

		if user
			p.w3-text-grey Está autenticado como #{user.nivel}.
		else
			p.w3-text-grey Está em modo anónimo. Use Entrar ou Registar para continuar.

	if news && news.length
		section.w3-card.w3-white.w3-padding.w3-margin-top
			h2 Últimas notícias
			each item in news
				article.news-item
					h3= item.titulo
					p= item.conteudo


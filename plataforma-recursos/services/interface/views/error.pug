extends layout

block content
	section.page-hero.page-hero--compact.page-hero--error
		.page-hero__content
			p.page-eyebrow Estado da plataforma
			h1= title || 'Erro'
			p.page-hero__lead= message || 'Ocorreu um erro.'
			.page-actions
				a.w3-button.botao-principal(href='/') Voltar ao início
				a.w3-button.w3-border(href='/resources') Ir para recursos


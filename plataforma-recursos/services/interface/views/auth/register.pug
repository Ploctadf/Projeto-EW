extends ../layout

block content
	section.w3-card.w3-white.w3-padding.w3-margin-top
		h1 Registar
		form(action='/auth/register' method='post')
			label(for='nome') Nome
			input#nome.w3-input(type='text' name='nome' required)

			label(for='email') Email
			input#email.w3-input(type='email' name='email' required)

			label(for='password') Password
			input#password.w3-input(type='password' name='password' minlength='6' required)

			label(for='filiacao') Filiação (opcional)
			input#filiacao.w3-input(type='text' name='filiacao')

			button.w3-button.w3-teal(type='submit') Criar conta

		p.w3-small
			| Já tem conta?
			a(href='/auth/login') Entre aqui.


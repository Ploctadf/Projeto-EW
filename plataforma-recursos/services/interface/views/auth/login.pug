extends ../layout

block content
	section.w3-card.w3-white.w3-padding.w3-margin-top
		h1 Entrar
		form(action='/auth/login' method='post')
			label(for='email') Email
			input#email.w3-input(type='email' name='email' required)

			label(for='password') Password
			input#password.w3-input(type='password' name='password' required)

			button.w3-button.w3-teal(type='submit') Iniciar sessão

		p.w3-small
			| Ainda não tem conta?
			a(href='/auth/register') Registe-se aqui.


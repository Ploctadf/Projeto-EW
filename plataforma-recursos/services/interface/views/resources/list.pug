extends ../layout

block content
	section.w3-card.w3-white.w3-padding.w3-margin-top
		h1 Recursos educativos
		p.w3-text-grey Total: #{pagination.total}

		- const f = filters || {}
		form(action='/resources' method='get')
			label(for='tipo') Tipo
			input#tipo.w3-input(type='text' name='tipo' value=(f.tipo || ''))

			label(for='ano') Ano
			input#ano.w3-input(type='number' name='ano' value=(f.ano || ''))

			label(for='tema') Tema
			input#tema.w3-input(type='text' name='tema' value=(f.tema || ''))

			label(for='hashtag') Hashtag
			input#hashtag.w3-input(type='text' name='hashtag' value=(f.hashtag || ''))

			button.w3-button.w3-teal(type='submit') Filtrar
			a.w3-button.w3-border(href='/resources') Limpar

		if user && (user.nivel === 'produtor' || user.nivel === 'admin')
			p
				a.w3-button.w3-border(href='/resources/new') Submeter recurso (SIP)

		if !items.length
				p Não existem recursos disponíveis.
		else
			table.w3-table-all.w3-hoverable.w3-striped
				thead
					tr.w3-teal
						th Título
						th Tipo
						th Ano
						th Ação
				tbody
					each item in items
						- const r = (item && item.metadata && item.metadata.resource) ? item.metadata.resource : {}
						tr
							td= r.titulo || 'Sem título'
							td= r.tipo || '-'
							td= r.ano || '-'
							td
								a(href=`/resources/${item._id}`) Ver detalhe

		p.w3-text-grey Página #{pagination.page} de #{pagination.totalPages}

